meta {
  name: Invalid API Key
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/v1/analyze
  body: json
  auth: none
}

headers {
  Authorization: Bearer wrong-key-12345
  Content-Type: application/json
}

body:json {
  {
    "source": "github",
    "repo_url": "https://github.com/a9320/coderisk-cloud"
  }
}

assert {
  res.status: eq 403
  res.body.detail: isDefined
}
