meta {
  name: Submit GitHub Analysis
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/analyze
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{apiKey}}
  Content-Type: application/json
}

body:json {
  {
    "source": "github",
    "repo_url": "https://github.com/a9320/coderisk-cloud",
    "branch": "main",
    "output_formats": ["json", "sarif"]
  }
}

assert {
  res.status: eq 200
  res.body.task_id: isDefined
  res.body.status: eq pending
  res.body.message: isDefined
}

script:post-response {
  // 自动将 task_id 存入环境变量，供后续测试使用
  if (res.body && res.body.task_id) {
    bru.setVar("taskId", res.body.task_id);
  }
}
