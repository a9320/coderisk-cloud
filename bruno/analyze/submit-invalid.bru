meta {
  name: Submit Invalid Request
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/v1/analyze
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{apiKey}}
}

body:json {
  {
    "source": "invalid_source",
    "repo_url": "not-a-url"
  }
}

assert {
  res.status: oneOf 400 422
}

tests {
  test("should reject invalid source", function() {
    expect(res.status).to.be.oneOf([400, 422]);
  });
  test("should return error detail", function() {
    expect(res.body.detail).to.exist;
  });
}
