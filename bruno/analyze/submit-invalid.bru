meta {
  name: Submit Invalid Request
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/v1/analyze
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{apiKey}}
  Content-Type: application/json
}

body:json {
  {
    "source": "invalid_source",
    "repo_url": "not-a-url"
  }
}

assert {
  res.status: gte 400
  res.status: lte 422
  res.body.detail: isDefined
}
