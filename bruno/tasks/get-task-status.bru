meta {
  name: Get Task Status
  type: http
  seq: 6
}

get {
  url: {{baseUrl}}/api/v1/tasks/{{taskId}}
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{apiKey}}
}

assert {
  res.status: eq 200
  res.body.task_id: eq {{taskId}}
  res.body.status: isDefined
  res.body.progress: gte 0
  res.body.progress: lte 100
  res.body.agent_status: isDefined
}
